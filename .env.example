# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# Gold AI Analyst Backend & Integration Services:
MARKET_DATA_API_KEY=your_market_data_api_key_here
NEWS_API_KEY=your_news_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
TRADINGVIEW_WEBHOOK_SECRET=your_tradingview_webhook_secret_here

# Database & Cache URLs:
DATABASE_URL=postgresql://gold_user:gold_secret@localhost:5432/gold_ai_db
REDIS_URL=redis://localhost:6379/0
